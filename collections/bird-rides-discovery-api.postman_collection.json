          "name": "Get GBFS Auto-Discovery",
          "request": {
            "name": "Get GBFS Auto-Discovery",
            "description": {
              "content": "Returns the GBFS auto-discovery document listing every sub-feed available for this Bird city, with URLs and feed names. Per GBFS v2.3, the response is wrapped in language-keyed feeds objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "gbfs.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "City slug for the desired Bird market. Examples include los-angeles, madrid, barcelona, helsinki, munich, ulm, calgary, edmonton, ottawa, halifax, antwerp, zurich, basel, biel, ulm, wienerneustadt. The canonical list lives in the MobilityData systems.csv at https://github.com/MobilityData/gbfs/blob/master/systems.csv.",
                  "type": "any",
                  "value": "{{city}}",
                  "key": "city"
                }
              ]
